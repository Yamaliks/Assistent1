{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Assistent1",
  "version": "0.1.1",
  "identifier": "com.assistent1.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Assistent1",
        "visible": false,
        "theme": "Dark",
        "url": "index.html",
        "width": 1180,
        "height": 760,
        "minWidth": 800,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#111218"
      },
      {
        "label": "palette",
        "title": "Assistent1 — Быстрая панель",
        "theme": "Dark",
        "url": "index.html?window=palette",
        "width": 560,
        "height": 520,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "backgroundColor": "#191B24"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 http://127.0.0.1:1420 ws://localhost:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
