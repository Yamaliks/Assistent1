{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Main UI may listen for events and request one validated Windows launch action; no general filesystem or shell API.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-execute-action",
    "allow-check-application-exe",
    "allow-pick-application-exe",
    "core:event:allow-emit",
    "core:event:allow-emit-to",
    "allow-prepare-mode-switch",
    "allow-confirm-mode-switch",
    "allow-sol-asset-status",
    "allow-sol-install",
    "allow-sol-audio",
    "allow-sol-start",
    "allow-sol-feed",
    "allow-sol-stop",
    "allow-pick-sol-archive"
  ]
}
